{
  "name": "shellmind",
  "version": "0.1.0",
  "description": "ShellMind — AI Terminal Copilot with Zero Auto-Execution Guardrails",
  "type": "module",
  "bin": {
    "ai": "./dist/bin.js",
    "shellmind": "./dist/bin.js"
  },
  "main": "dist/bin.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --tsconfig=../../tsconfig.json --outfile=dist/bin.js --external:@google/genai --external:commander",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0"
  }
}
